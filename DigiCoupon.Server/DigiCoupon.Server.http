@DigiCoupon.Server_HostAddress = https://localhost:7181/api
@DigiCoupon.Register = /auth/register
@DigiCoupon.Login = /auth/login
@DigiCoupon.Restuarant = /restuarant
@DigiCoupon.Branch = /restuarant/branch
@DigiCoupon.AllBranch = /restuarant/all_branch
@Token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nVlz-I2ZANn7GkYeIvtRNvERJ7JKgu2ypLEggpre84o

### register request
POST {{DigiCoupon.Server_HostAddress}}{{DigiCoupon.Register}}
Accept: application/json
Content-Type: application/json
{
  "Name":"User One",
  "Email":"user_one@gmail.com",
  "Mobile":"1111111111",
  "Password":"11111111"
}

###  login request
POST {{DigiCoupon.Server_HostAddress}}{{DigiCoupon.Login}}
Accept:application/json
Content-Type:application/json
{
  "UserName":"1111111111",
  "Password":"11111111"
}

### restuarant post request 
POST {{DigiCoupon.Server_HostAddress}}{{DigiCoupon.Restuarant}}
Accept: application/json
Content-Type: application/json
Authorization:Bearer {{Token}}
{
  "Id":0,
  "Name":"Restuarant A",
  "Email":"restuarant_a@gmail.com",
  "Mobile":"1111111111",
  "FssaiLicenseNo":"FSSAI001",
  "Address":"Rajkot"
}

